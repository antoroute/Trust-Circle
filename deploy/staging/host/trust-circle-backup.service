[Unit]
Description=CircleHaven staging encrypted PostgreSQL backup
RequiresMountsFor=/mnt/truenas
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=trust-circle-backup
RuntimeDirectoryMode=0700
StateDirectory=trust-circle-backup
StateDirectoryMode=0700
EnvironmentFile=/etc/trust-circle-backup/config
ExecStart=/usr/local/sbin/trust-circle-backup backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/trust-circle-backup
ReadWritePaths=/var/lib/trust-circle-backup
ReadWritePaths=/var/lib/prometheus/node-exporter
ReadWritePaths=/mnt/truenas
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
